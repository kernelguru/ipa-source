#!/bin/sh
# fake ideviceinstaller with the current subcommand syntax: -u UDID install PATH
if [ "$1" = "-h" ]; then
  printf 'Usage: ideviceinstaller OPTIONS\nCOMMANDS:\n  list                List installed apps.\n  install PATH        Install app from package file specified by PATH.\n'
  exit 0
fi
if [ "$3" != "install" ]; then echo "Bug Reports: <https://github.com/libimobiledevice/ideviceinstaller/issues>"; exit 2; fi
echo "Uploading $(basename "$4") package contents... DONE."
for p in 5 15 40 60 90; do echo "Install: Step ($p%)"; sleep 0.2; done
echo "Install: Complete"
